{
  "name": "teletwin-mobile",
  "private": true,
  "description": "TeleTwin Android and iOS shells (Capacitor) that open the hosted web app",
  "scripts": {
    "sync": "cap sync android",
    "sync:ios": "cap sync ios",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "aab:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
